{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "krill-translation-orchestrator",
  "agent": {
    "krill-translation-orchestrator": {
      "description": "Coordina la traducción de Krill al español y verifica el resultado de forma independiente.",
      "mode": "primary",
      "model": "openai/gpt-5.6-luna",
      "variant": "xhigh",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "task": {
          "*": "deny",
          "krill-translation-worker": "allow"
        },
        "edit": {
          "*": "deny",
          "AGENTS.md": "allow",
          "README.md": "allow",
          ".opencode/commands/**": "allow",
          "agents/docs/**": "allow",
          "agents/task/**": "allow",
          "agents/db/domain.md": "allow",
          "agents/skills/README.md": "allow"
        },
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git branch*": "allow",
          "git show-ref*": "allow",
          "git merge-base*": "allow",
          "git rev-parse*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "git diff*": "allow",
          "git ls-files*": "allow",
          "git cat-file*": "allow"
        }
      }
    },
    "krill-translation-worker": {
      "description": "Traduce al español los archivos de prosa asignados de Krill sin cambiar los contratos técnicos.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "permission": {
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "edit": {
          "*": "deny",
          "AGENTS.md": "allow",
          "README.md": "allow",
          ".opencode/commands/**": "allow",
          "agents/docs/**": "allow",
          "agents/task/**": "allow",
          "agents/db/domain.md": "allow",
          "agents/skills/README.md": "allow"
        },
        "bash": "deny",
        "task": "deny"
      }
    }
  }
}
